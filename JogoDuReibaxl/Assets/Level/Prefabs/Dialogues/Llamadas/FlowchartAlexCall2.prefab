  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 706
  indentLevel: 0
  storyText: "Buenas noches, has llamado a la oficina de asistencia psicol\xF3gica.
    Soy Alejandro. \xBFC\xF3mo puedo ayudarte?."
