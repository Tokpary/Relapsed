  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1249
  indentLevel: 0
  storyText: "Gracias por contarme todo esto, \xC1lex. Est\xE1s siendo de gran ayuda.
    Ahora me gustar\xEDa que habl\xE1semos de..."
