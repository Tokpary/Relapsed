  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1255
  indentLevel: 0
  storyText: "\xC1lex, s\xE9 que est\xE1s nervioso. Pero es importante que hagas
    caso a tu madre. Voy a llamar a la polic\xEDa ahora mismo para que puedan ayudaros
    a que las cosas mejoren. Pero ahora, tienes que esconderte. Si necesitas hablar,
    podemos hacerlo en cualquier momento. Pero ahora, haz caso a tu madre, por favor.           "
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
