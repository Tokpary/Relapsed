--- !u!114 &7096239970147293674
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8905345127674671010}
  m_Enabled: 1
  m_EditorHideFlags: 0
