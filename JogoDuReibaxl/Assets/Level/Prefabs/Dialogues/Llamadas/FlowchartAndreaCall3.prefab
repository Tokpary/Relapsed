  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1199
  indentLevel: 0
  storyText: "Un Sol ego\xEDsta que no quiere dejarte ver el horizonte en todo su
    esplendor."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 1
  fadeWhenDone: 1
