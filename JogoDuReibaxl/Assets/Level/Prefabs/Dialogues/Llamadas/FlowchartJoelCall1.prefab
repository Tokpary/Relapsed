  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 6
  indentLevel: 0
  storyText: "Buenos d\xEDas, soy Alejandro de las oficinas de asistencia psicol\xF3gica,
    estoy aqu\xED para ayudarte. \xBFQu\xE9 puedo hacer por ti?"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
