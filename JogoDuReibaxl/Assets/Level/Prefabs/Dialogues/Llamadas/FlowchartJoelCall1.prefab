  m_EditorClassIdentifier: 
  itemId: 787
  indentLevel: 0
  text: '[Guardar Silencio]'
  description: 
  targetBlock: {fileID: 1971802944314464524}
  hideIfVisited: 1
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
