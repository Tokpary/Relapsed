--- !u!114 &2003834978624518081
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 785
  indentLevel: 0
  text: "Es normal sentirse as\xED en una situaci\xF3n tan complicada. S\xE9 que
    sientes que nadie entiende por lo que est\xE1s pasando, pero aunque no lo creas,
    siempre va a haber alguien dispuesto a ayudarte. Yo estar\xE9 aqu\xED para ayudarte
    siempre que lo necesites."
  description: 
  targetBlock: {fileID: 3056042323710630090}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &8596607508068765213
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 786
  indentLevel: 0
  text: "Nadie est\xE1 en tu contra. Entiendo que te puedas sentir mal a ra\xEDz
    de que tus compa\xF1eros te molesten, pero tienes que entender que hay mucha
    gente que no tiene ning\xFAn problema contigo."
  description: 
  targetBlock: {fileID: 3540171069813303986}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
