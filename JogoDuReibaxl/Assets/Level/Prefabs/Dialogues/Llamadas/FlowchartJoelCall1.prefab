--- !u!114 &2900874676752075596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 835
  indentLevel: 0
  storyText: "\xBFMe est\xE1s diciendo que en todo esto el problema lo tengo yo?
    Ya veo de qu\xE9 palo vas."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
