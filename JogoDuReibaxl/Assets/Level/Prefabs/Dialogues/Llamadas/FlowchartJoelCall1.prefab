--- !u!114 &7646204030352660387
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 828
  indentLevel: 0
  storyText: 'Por cierto, me llamo Joel. '
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &43375239181933175
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 829
  indentLevel: 0
  storyText: "\xA1Todos actu\xE1is igual! A nadie le importa una mierda por lo que
    estoy pasando."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &6330939278246571884
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 831
  indentLevel: 0
  storyText: "Estoy soportando burlas e insultos a todas horas y el mayor problema
    es como hablo de mis padres. Tranquilo, que no volver\xE9 a llamar."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &5112221472632526812
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 832
  indentLevel: 0
  text: "Te sientes completamente ahogado por la situaci\xF3n, \xBFverdad? Entiendo
    como te sientes y, aunque no conozco la situaci\xF3n con tus padres, creo que
    una parte de ti busca a alguien a quien culpar de la situaci\xF3n."
  description: 
  targetBlock: {fileID: 3667987662767513100}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &5626353354632256305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 833
  indentLevel: 0
  text: "Creo que no deber\xEDas hablar as\xED de tus padres. Todo el mundo puede
    atravesar malos momentos en su vida que le lleve por caminos indeseados, es algo
    normal que muchas veces escapa de nuestro control."
  description: 
  targetBlock: {fileID: 5907515927648131146}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &3394270362562273505
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048841494740265434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 834
  indentLevel: 0
  storyText: "\xBFQuieres que hablemos un poco m\xE1s de c\xF3mo te sientes?"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
