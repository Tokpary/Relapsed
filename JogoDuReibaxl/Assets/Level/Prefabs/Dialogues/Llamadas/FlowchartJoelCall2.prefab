  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 741
  indentLevel: 0
  storyText: "Supongo que podr\xEDa probar. Y la idea de cambiar la mesa por un cuaderno
    puede estar bien."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
