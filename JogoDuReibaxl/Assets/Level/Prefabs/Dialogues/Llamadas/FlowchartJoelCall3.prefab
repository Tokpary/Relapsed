  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 725
  indentLevel: 0
  text: 'Lo mismo que hiciste cuando decidiste llamarme por primera vez, pedir ayuda.
    No has sido consciente nunca de ello, pero siempre has querido hacerlo. '
  description: 
  targetBlock: {fileID: 8422591701245877338}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
