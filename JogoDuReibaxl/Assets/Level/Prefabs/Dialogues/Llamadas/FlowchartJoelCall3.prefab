--- !u!114 &8670367836021146375
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6154727812934149547}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 864
  indentLevel: 0
  text: "Creo que es m\xE1s importante que hablemos de lo que te ha pasado hoy en
    el colegio."
  description: 
  targetBlock: {fileID: 7944706277925969288}
  hideIfVisited: 0
