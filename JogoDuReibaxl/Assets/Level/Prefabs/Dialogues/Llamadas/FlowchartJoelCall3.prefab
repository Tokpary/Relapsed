  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 855
  indentLevel: 0
  storyText: "S\xE9 que he hecho mal, s\xE9 que no es la soluci\xF3n. Pero no aguantaba
    m\xE1s."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
