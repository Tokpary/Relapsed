  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &3265034050189362582
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6154727812934149547}
  m_Enabled: 1
