--- !u!114 &2767246929654397120
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6154727812934149547}
  m_Enabled: 1
  m_EditorHideFlags: 0
