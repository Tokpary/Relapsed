  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 859
  indentLevel: 0
  storyText: "Me han dejado para el arrastre, pero no pod\xEDa soportar un solo comentario
    m\xE1s sobre mi madre."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
