  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 854
  indentLevel: 0
  storyText: "Me he acercado a uno de los chicos que m\xE1s me molestaban, y le he
    dado un pu\xF1etazo."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
