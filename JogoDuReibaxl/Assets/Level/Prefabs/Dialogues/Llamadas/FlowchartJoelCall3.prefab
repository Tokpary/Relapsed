  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 863
  indentLevel: 0
  text: "Entiendo, Joel. Es un gran paso. Si crees que est\xE1s preparado, estar\xE9
    encantado de escucharte y ayudarte."
  description: 
  targetBlock: {fileID: 801494009187558579}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
