  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 44
  indentLevel: 0
  storyText: "S\xE9 que es un momento muy complicado ahora, pero necesito que intentes
    controlar la respiraci\xF3n para poder hablar bien contigo y ayudarte."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
