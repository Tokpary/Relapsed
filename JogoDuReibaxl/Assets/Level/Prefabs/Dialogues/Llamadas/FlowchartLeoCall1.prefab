  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 380
  indentLevel: 0
  storyText: "Confuso y con miedo. La noticia de mi madre hizo que me acordase de
    ella y arrepentirme por la forma en la que me comport\xE9 con ella. "
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
