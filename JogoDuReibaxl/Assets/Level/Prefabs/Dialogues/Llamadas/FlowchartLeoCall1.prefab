  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 238
  indentLevel: 0
  storyText: 'Es un trabajo que me llena y que me hace sentir realizado. Al fin y
    al cabo esta me hizo ver el mundo lleno de color otra vez. '
