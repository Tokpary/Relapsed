  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 6
  indentLevel: 0
  storyText: " Buenos d\xEDas, mi nombre es Alejandro. Has llamado a las oficinas
    de asistencia psicol\xF3gica, yo ser\xE9 quien te atienda. \xBFC\xF3mo te puedo
    ayudar?"
