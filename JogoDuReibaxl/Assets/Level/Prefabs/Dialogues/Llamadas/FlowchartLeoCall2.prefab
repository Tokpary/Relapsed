  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 329
  indentLevel: 0
  text: "Solo el hecho de que te preocupes por ella despu\xE9s de tanto tiempo demuestra
    el cari\xF1o que tienes hacia ella. A\xFAn est\xE1s a tiempo de ponerte en contacto
    con ella si es lo que necesitas."
  description: 
  targetBlock: {fileID: 1965516297789674968}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
