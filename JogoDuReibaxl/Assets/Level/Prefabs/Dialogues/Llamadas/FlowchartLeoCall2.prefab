  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 107
  indentLevel: 0
  storyText: "Cada vez que intento llamarla me quedo de piedra, pensando en qu\xE9
    le dir\xE9, en como podr\xEDa pedirle perd\xF3n por todo."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
