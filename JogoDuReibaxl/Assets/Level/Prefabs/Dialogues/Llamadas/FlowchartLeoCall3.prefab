  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 400
  indentLevel: 0
  storyText: "Si tan solo hubiera tenido un poco m\xE1s... Ni a\xFAn contando con
    tu ayuda he podido afrontar la situaci\xF3n."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
