  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 397
  indentLevel: 0
  storyText: "El motivo por el que estoy aqu\xED es poder ayudar a la gente a que
    se sienta mejor. No tienes que darme las gracias. "
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
