MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5239381304985388392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 503
  indentLevel: 0
  text: "Eso no es verdad, Leo. Todos tenemos un prop\xF3sito, algo por lo que luchar."
  description: 
  targetBlock: {fileID: 9010575981013687319}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
