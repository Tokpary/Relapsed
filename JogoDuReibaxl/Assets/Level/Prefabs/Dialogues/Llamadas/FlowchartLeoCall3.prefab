  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 396
  indentLevel: 0
  storyText: "Eso no importa ahora mismo, solo quer\xEDa hablar contigo por \xFAltima
    vez. Me has ayudado mucho y quer\xEDa darte las gracias. "
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
