  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 501
  indentLevel: 0
  storyText: "Nada en este mundo tiene sentido ya, ni siquiera mi propia existencia.
    Desde aqu\xED arriba lo veo todo mucho m\xE1s claro."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
