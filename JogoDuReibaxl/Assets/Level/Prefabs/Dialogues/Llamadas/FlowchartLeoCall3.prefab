  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 508
  indentLevel: 0
  storyText: "Por mucho que intentes animarme, yo ya estoy harto de intentar pelear
    todos los d\xEDas y que el mundo est\xE9 en mi contra. No puedo seguir adelante."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
