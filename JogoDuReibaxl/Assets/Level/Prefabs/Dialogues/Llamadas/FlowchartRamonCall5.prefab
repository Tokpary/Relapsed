  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 29
  indentLevel: 0
  storyText: Dicho esto, comenzaremos con el simulacro. En la hoja colocada en tu
    bandeja tienes por escrito todas las instrucciones que te he dado. Te recomiendo
    tenerla delante durante nuestra llamada.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
