  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 3
  indentLevel: 0
  storyText: "Soy Ram\xF3n. Gracias por presentarte voluntariamente al programa de
    asistencia psicol\xF3gica, la verdad que actualmente estamos un poco cortos de
    personal."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
