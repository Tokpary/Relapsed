--- !u!114 &877321203358512203
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4313517333292096428}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 101
  indentLevel: 0
  text: "Te entiendo. No te preocupes, estoy aqu\xED para ayudarte. Has hecho bien
    llamando por tel\xE9fono, es un gran paso. \xBFPuedo preguntarte m\xE1s acerca
    del tema? \xBFSobre c\xF3mo empezaste a apostar?"
  description: 
  targetBlock: {fileID: 3225888999742152775}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &894762763077936127
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4313517333292096428}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 102
  indentLevel: 0
  text: "Entiendo. Lo m\xE1s importante en estos casos es ser consciente de nuestra
    situaci\xF3n para poder actuar y mejorar. "
  description: 
  targetBlock: {fileID: 222324157181615419}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
