  indentLevel: 0
  text: '[Guardar Silencio]'
  description: 
  targetBlock: {fileID: 369881639}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
