  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 788
  indentLevel: 0
  storyText: "Todo esto es culpa de mis padres. Si no se hubieran comportado as\xED,
    si se hubiesen preocupado m\xEDnimamente por m\xED, yo no tendr\xEDa que estar
    soportando esto.  Antes de tener que mudarme todo era mucho m\xE1s f\xE1cil,
    pero ten\xEDan que cargarse todo."
  description: 
  character: {fileID: 1297963683}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
