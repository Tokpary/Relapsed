  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 787
  indentLevel: 0
  storyText: "\xBFCon qui\xE9n narices est\xE1s hablando, Alex? Te tengo dicho que
    no cojas el tel\xE9fono. \xA1Trae aqu\xED!"
