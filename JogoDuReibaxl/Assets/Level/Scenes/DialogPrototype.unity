  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 114
  indentLevel: 0
  storyText: "Tratar\xE9 de darle m\xE1s importancia y mejorar a partir de ahora.
    \xBFTe importa si hablamos del tiempo que llevas apostando?"
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
