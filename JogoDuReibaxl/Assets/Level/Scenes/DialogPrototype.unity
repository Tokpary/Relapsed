  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1267
  indentLevel: 0
  storyText: No puedo revivir esto ahora mismo. No puedo soportarlo.
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
