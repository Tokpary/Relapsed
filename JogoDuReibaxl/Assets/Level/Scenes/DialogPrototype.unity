  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1315
  indentLevel: 0
  storyText: "A m\xED tambi\xE9n me hubiera gustado que las cosas fuesen bien, pero
    ahora no podemos hacer m\xE1s que salir adelante."
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
