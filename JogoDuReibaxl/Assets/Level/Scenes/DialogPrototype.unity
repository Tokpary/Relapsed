  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1314
  indentLevel: 0
  storyText: "Creo que es demasiada presi\xF3n para m\xED. Pasar por estas cosas
    una y otra vez, recordar a Aurora, el instituto, a mam\xE1 y pap\xE1\u2026 No
    puedo soportarlo m\xE1s."
  description: 
  character: {fileID: 1157908968}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
