  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 436
  indentLevel: 0
  text: Tienes que sacar el valor de enfrentarte a ellos. No puedes quedarte paralizado
    cada vez que te molesten.
  description: 
  targetBlock: {fileID: 877118299}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
