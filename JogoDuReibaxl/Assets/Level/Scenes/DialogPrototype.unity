  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 382
  indentLevel: 0
  storyText: "Tengo miedo de perder el trabajo, mi \xFAnica raz\xF3n de ser, mi \xFAnico
    motivo por las que me levanto por las ma\xF1anas."
  description: 
  character: {fileID: 2093562435}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
