  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 826
  indentLevel: 0
  storyText: "\u2026Est\xE1 bien. No me gusta hablar de mis padres, pero creo que
    podr\xEDamos hablar de otras cosas de vez en cuando."
  description: 
  character: {fileID: 1297963683}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
