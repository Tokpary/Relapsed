  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1313
  indentLevel: 0
  storyText: Es normal que sea duro, pero es parte del proceso. Gracias a estos momentos
    es por los que podemos salir adelante.
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
