  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1311
  indentLevel: 0
  storyText: "Pero no puedo evitar pensar en c\xF3mo hubiese sido todo si no hubi\xE9semos
    elegido el trabajo por encima de mam\xE1. "
  description: 
  character: {fileID: 1157908968}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &1002348969
