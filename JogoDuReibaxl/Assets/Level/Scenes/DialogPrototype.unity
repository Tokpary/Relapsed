  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 106
  indentLevel: 0
  storyText: "\xBFTe importar\xEDa hablarme acerca del tiempo que llevas apostando?
    As\xED, podemos buscar formas de avanzar juntos."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
