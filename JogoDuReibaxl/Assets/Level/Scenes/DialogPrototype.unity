  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 963
  indentLevel: 0
  storyText: "Ahora ve, y habla con ella, s\xE9 que est\xE1s preparado. Si necesitas
    ayuda, yo estar\xE9 aqu\xED, esperando tu llamada."
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
