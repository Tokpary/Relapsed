  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 964
  indentLevel: 0
  storyText: "Te escribir\xE9 pronto, te prometo que saldr\xE9 adelante. Ha sido
    un placer conocerte, Alejandro."
  description: 
  character: {fileID: 451395240}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
