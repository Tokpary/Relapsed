  m_EditorClassIdentifier: 
  itemId: 1316
  indentLevel: 0
  storyText: "Quiz\xE1\u2026 \xBFsea demasiada presi\xF3n? \xBFEstoy realmente preparado
    para esto?"
  description: 
  character: {fileID: 1157908968}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
