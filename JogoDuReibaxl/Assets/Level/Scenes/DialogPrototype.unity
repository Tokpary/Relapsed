  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 693
  indentLevel: 0
  storyText: " Creo\u2026 que estoy algo mejor."
  description: 
  character: {fileID: 451395240}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
