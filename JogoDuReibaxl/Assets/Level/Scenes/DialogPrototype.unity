  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 107
  indentLevel: 0
  storyText: "\xBFEst\xE1 usted anim\xE1ndome a apostar? \xBFEs esto una broma?"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
