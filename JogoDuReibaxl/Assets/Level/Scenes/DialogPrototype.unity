  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1312
  indentLevel: 0
  storyText: Revivir todas esas cosas es muy doloroso, pero es necesario para avanzar.
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
