  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 874
  indentLevel: 0
  storyText: "Pero cuando empezaron a meterse conmigo, dej\xE9 de hacerlo. No pod\xEDa
    pasar tiempo con ella sin enfurecerme."
  description: 
  character: {fileID: 451395240}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
