--- !u!114 &1988980620
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1988980544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 103
  indentLevel: 0
  text: "Bueno, una partidita de vez en cuando no hace da\xF1o a nadie. Al fin y
    al cabo, somos humanos y todos buscamos alguna actividad l\xFAdica de vez en
    cuando \xBFno? "
  description: 
  targetBlock: {fileID: 1988980636}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &1988980621
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1988980544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 102
  indentLevel: 0
  text: "Entiendo. Lo m\xE1s importante en estos casos es ser consciente de nuestra
    situaci\xF3n para poder actuar y mejorar. "
  description: 
  targetBlock: {fileID: 1988980639}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &1988980622
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1988980544}
  m_Enabled: 1
