  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 965
  indentLevel: 0
  storyText: "Creo\u2026 que me has convencido, Alejandro. Intentar\xE9 hablar con
    ella y hacer las cosas bien. "
  description: 
  character: {fileID: 451395240}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
