  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 402
  indentLevel: 0
  storyText: "Lo siento mucho, mam\xE1.  "
  description: 
  character: {fileID: 2093562435}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
