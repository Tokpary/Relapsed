  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 785
  indentLevel: 0
  storyText: "Eres el chico del otro d\xEDa, \xBFverdad? Te escucho un poquito bajo."
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
