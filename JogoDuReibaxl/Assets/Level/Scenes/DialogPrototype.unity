  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 133
  indentLevel: 0
  text: "Lo est\xE1s haciendo bien, Ram\xF3n. T\xF3mate el tiempo que necesites."
  description: 
  targetBlock: {fileID: 1093396409}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
