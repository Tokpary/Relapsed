  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 781
  indentLevel: 0
  storyText: "Perfecto, \xC1lex. Cu\xE9ntame, qu\xE9 haces despierto a estas horas? "
  description: 
  character: {fileID: 1607360311}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
