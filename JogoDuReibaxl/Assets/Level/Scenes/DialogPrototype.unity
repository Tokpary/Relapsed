  text: '[Guardar Silencio]'
  description: 
  targetBlock: {fileID: 240580314}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
