  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 111
  indentLevel: 0
  storyText: "Perdona, me qued\xE9 absorto en mis pensamientos. "
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
