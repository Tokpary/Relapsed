  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 862
  indentLevel: 0
  storyText: "Creo que necesito desahogarme, no he hablado de nada desde el d\xEDa
    en que se torci\xF3 todo. "
  description: 
  character: {fileID: 451395240}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
