  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 247
  indentLevel: 0
  storyText: "Creo que la complicada situaci\xF3n familiar por la que pasamos en
    mi infancia, hizo que se superase. Se vio empujada a ese pozo sin fondo."
  description: 
  character: {fileID: 2093562435}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
