    - target: {fileID: 3606030652794883675, guid: b5d3096387a54294884a0888532563fd,
        type: 3}
      propertyPath: storyText
      value: "Entre chicos de tu edad es normal que haya este tipo de peleas. \xBFHas
        intentado hablar con ellos para que no te molesten m\xE1s?"
