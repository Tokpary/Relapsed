  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1002
  indentLevel: 0
  storyText: "S\xED, me gusta sentirme vivo y ser yo mismo, no quiero dejar de ver
    esos colores que tanto me ha costado apreciar."
