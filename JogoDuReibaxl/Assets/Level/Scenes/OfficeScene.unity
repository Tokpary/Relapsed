      objectReference: {fileID: 111433657}
    - target: {fileID: 565315958826211791, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: text
      value: "El hecho de que te preocupes por ella demuestra todo el cari\xF1o que
        sientes."
      objectReference: {fileID: 0}
    - target: {fileID: 657077444123637373, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: character
      value: 
      objectReference: {fileID: 131937782}
    - target: {fileID: 657077444123637373, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: storyText
      value: "\xBFPor qu\xE9 no intentas plasmar tus sentimientos en un papel?"
      objectReference: {fileID: 0}
    - target: {fileID: 657200499597179508, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: character
      value: 
      objectReference: {fileID: 499699927}
    - target: {fileID: 667357766305639897, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: text
      value: Te entiendo, pero a tu madre no le queda mucho tiempo.
      objectReference: {fileID: 0}
