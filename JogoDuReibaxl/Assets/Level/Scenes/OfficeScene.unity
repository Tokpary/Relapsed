      objectReference: {fileID: 2022235535}
    - target: {fileID: 7953375966495460324, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: text
      value: Tienes que sacar el valor para enfrentarlos.
      objectReference: {fileID: 0}
    - target: {fileID: 8061679995906209002, guid: 4c37e688e004ad949a95e4b6d9ea9732,
