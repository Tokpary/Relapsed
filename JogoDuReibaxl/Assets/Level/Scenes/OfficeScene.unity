  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1097
  indentLevel: 0
  storyText: "Vas por buen camino, recuerda que yo estar\xE9 aqu\xED para brindarte
    la confianza que neceistes."
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
