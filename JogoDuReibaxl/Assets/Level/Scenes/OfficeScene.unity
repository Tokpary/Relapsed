--- !u!114 &1956654357
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 572221005}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1117
  indentLevel: 0
  storyText: Te voy a estar agradecido siempre. De no ser por tu ayuda me hubiera
    rendido hace mucho. Me has salvado la vida.
  description: 
  character: {fileID: 499699927}
