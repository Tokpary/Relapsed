--- !u!114 &1873683517
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1873683507}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1318
  indentLevel: 0
  storyText: "Exacto, por eso mismo. Si para ti lo ha sido, imag\xEDnate para \xE9l.
    \xBFNo crees que tendr\xEDas que haber recogido un m\xEDnimo de informaci\xF3n
    para poder ayudarle? "
  description: 
  character: {fileID: 1805410649}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
