  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1311
  indentLevel: 0
  storyText: "Si ella est\xE1 de acuerdo, seguiremos con ese m\xE9todo. "
  description: "Claro que no. Hablemos primero del ni\xF1o con el que has hablado.
    \xBFEst\xE1s satisfecho con c\xF3mo le has atendido?"
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
