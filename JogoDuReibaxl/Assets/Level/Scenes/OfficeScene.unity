--- !u!114 &1177913896
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1177913388}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1006
  indentLevel: 0
  storyText: "\xBF\xA1C\xF3mo se supone que vamos a tratarlo!? Mi madre est\xE1 enferma
    de gravedad, y no est\xE1s siendo de ayuda."
