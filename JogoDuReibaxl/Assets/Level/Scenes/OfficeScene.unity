    - target: {fileID: 7273519224991577461, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: storyText
      value: "\xBFHay algo m\xE1s que haya pasado en clase de lo que quieras hablarme?"
      objectReference: {fileID: 0}
    - target: {fileID: 7422267520569850075, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: text
      value: Creo que descubrir eso es tu labor.
      objectReference: {fileID: 0}
    - target: {fileID: 7734688931884514788, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: storyText
      value: "Dice mucho de ti que no est\xE9s poni\xE9ndote a su nivel, Joel. Es
        normal que si muchos de tus compa\xF1eros se portan mal contigo no quieras
        hablar en clase. "
      objectReference: {fileID: 0}
    - target: {fileID: 7740324901610175007, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
