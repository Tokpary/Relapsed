  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1317
  indentLevel: 0
  storyText: "\xBFQu\xE9 vas a hacer cuando esa situaci\xF3n explote? \xBFPodr\xE1s
    cargar con la culpa de lo que le pase al pobre ni\xF1o?"
  description: 
  character: {fileID: 1805410649}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
