--- !u!114 &1212397996
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 763702765}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1038
  indentLevel: 0
  storyText: "Siempre que se acercan a re\xEDrse de m\xED me siento\u2026 furioso.
    Antes de hoy, pensaba que simplemente no sab\xEDan c\xF3mo me sent\xEDa, que
    hablaban sin saber. "
  description: 
  character: {fileID: 2022235535}
