  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1334
  indentLevel: 0
  storyText: "L-lo siento. Sab\xEDa que no lo estaba haciendo del todo bien."
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
