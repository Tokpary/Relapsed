        type: 3}
      propertyPath: storyText
      value: "\xBFQuieres que hablemos de c\xF3mo te hacen sentir?"
      objectReference: {fileID: 0}
    - target: {fileID: 8090766044744242509, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: storyText
      value: "\xBFHola? \xBFHay alguien ah\xED?"
