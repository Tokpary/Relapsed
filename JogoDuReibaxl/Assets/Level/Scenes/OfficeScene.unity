    - target: {fileID: 6613153102200183520, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: storyText
      value: "Si te sientes mal, siempre puedes coger un cuaderno y escribir o dibujar
