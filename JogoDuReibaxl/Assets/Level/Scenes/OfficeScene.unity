    - target: {fileID: 3134221202214969559, guid: b5d3096387a54294884a0888532563fd,
        type: 3}
      propertyPath: text
      value: Estas cosas son normales entre los chicos de tu edad.
      objectReference: {fileID: 0}
    - target: {fileID: 3199812684232371587, guid: b5d3096387a54294884a0888532563fd,
