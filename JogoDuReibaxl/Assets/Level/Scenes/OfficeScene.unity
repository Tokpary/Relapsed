  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1320
  indentLevel: 0
  storyText: "Claro que s\xED. Hablemos primero del ni\xF1o con el que has hablado.
    \xBFEst\xE1s satisfecho con c\xF3mo le has atendido?"
  description: 
  character: {fileID: 1805410649}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
