  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1100
  indentLevel: 0
  storyText: "No me puedo creer que esto haya ocurrido as\xED. "
  description: 
  character: {fileID: 499699927}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
