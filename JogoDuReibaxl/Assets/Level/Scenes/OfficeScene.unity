  m_EditorClassIdentifier: 
  itemId: 1306
  indentLevel: 0
  storyText: "\xBFQu\xE9 vas a hacer cuando esa situaci\xF3n explote? \xBFPodr\xE1s
    cargar con la culpa de lo que le pase al pobre ni\xF1o?"
  description: "Claro que no. Hablemos primero del ni\xF1o con el que has hablado.
    \xBFEst\xE1s satisfecho con c\xF3mo le has atendido?"
