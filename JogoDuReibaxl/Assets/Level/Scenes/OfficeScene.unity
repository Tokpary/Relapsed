    - target: {fileID: 382359420322611861, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: storyText
      value: "No debes martirizarte por tu decisi\xF3n, tu madre no ha estado presente
        en gran parte de tu vida y es l\xF3gico que priorices tu felicidad individual."
      objectReference: {fileID: 0}
    - target: {fileID: 488700503411823733, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: text
      value: La verdad que no.
      objectReference: {fileID: 0}
    - target: {fileID: 501401736008060814, guid: 9b9e45b02aeba8f42a5c52dbb856dfe4,
        type: 3}
      propertyPath: nodeRect.width
      value: 138.37201
      objectReference: {fileID: 0}
