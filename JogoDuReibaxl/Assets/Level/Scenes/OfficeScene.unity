  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1319
  indentLevel: 0
  storyText: "Era... una situaci\xF3n complicada."
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
