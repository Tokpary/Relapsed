  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1003
  indentLevel: 0
  storyText: "No te desmorones hombre, ya ver\xE1s como todo va a mejorar."
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
