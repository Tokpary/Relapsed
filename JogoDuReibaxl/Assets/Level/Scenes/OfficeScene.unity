        type: 3}
      propertyPath: text
      value: "\xBFQuieres que hablemos de c\xF3mo te sientes?"
      objectReference: {fileID: 0}
    - target: {fileID: 1865672141033087731, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: text
      value: "\xBFHay algo m\xE1s que quieras contarme de clase?"
      objectReference: {fileID: 0}
