    - target: {fileID: 3993397677699359919, guid: b5d3096387a54294884a0888532563fd,
        type: 3}
      propertyPath: storyText
      value: "Nadie est\xE1 en tu contra. Entiendo que te puedas sentir mal a ra\xEDz
        de que tus compa\xF1eros te molesten, pero tienes que entender que hay mucha
        gente que no tiene ning\xFAn problema contigo."
      objectReference: {fileID: 0}
    - target: {fileID: 4160240433746179858, guid: b5d3096387a54294884a0888532563fd,
        type: 3}
      propertyPath: character
