  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 887
  indentLevel: 0
  storyText: "Vaya, \xBFHoy tienes cena familiar?"
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
