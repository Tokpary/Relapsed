    - target: {fileID: 3199812684232371587, guid: b5d3096387a54294884a0888532563fd,
        type: 3}
      propertyPath: storyText
      value: "Perdona, no pretend\xEDa juzgarte, y menos sin conocer tu situaci\xF3n.
        Quer\xEDa que supieses que, aunque te sientas superado, centrarse en culpar
        a alguien no es la soluci\xF3n."
      objectReference: {fileID: 0}
