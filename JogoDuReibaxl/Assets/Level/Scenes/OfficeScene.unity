  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 916
  indentLevel: 0
  storyText: Todo el mundo puede atravesar malos momentos en su vida que le lleve
    por caminos indeseados, es algo normal que muchas veces escapa de nuestro control.
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 0
