    - target: {fileID: 2150918352957713561, guid: 4c37e688e004ad949a95e4b6d9ea9732,
        type: 3}
      propertyPath: storyText
      value: "Entiendo c\xF3mo te sientes, pero te puedo asegurar que eso no es as\xED.
        El otro d\xEDa me dijiste que estabas esperando a tu t\xEDa para comer, seguro
        que con ella puedes pasar un buen rato y distraerte un poco, \xBFno crees?"
      objectReference: {fileID: 0}
