  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 915
  indentLevel: 0
  storyText: " No tienes ni idea de todo lo que he tenido que pasar por su culpa.
    Yo no me merec\xEDa pasar por todo eso solo por las malas decisiones que han
    tomado."
