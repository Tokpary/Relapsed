  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1095
  indentLevel: 0
  storyText: "\xBFC\xF3mo no me voy a martirizar si estoy abandonando a mi madre?
    Siento constantemente que no estoy haciendo lo correcto."
  description: 
  character: {fileID: 499699927}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
