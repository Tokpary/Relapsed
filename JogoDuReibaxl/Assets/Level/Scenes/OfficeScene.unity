  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1336
  indentLevel: 0
  storyText: "\xBFO al pobre articulista con su madre? Si sigues as\xED vas a conseguir
    que acabe saltando desde lo alto de una azotea."
  description: 
  character: {fileID: 1805410649}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
