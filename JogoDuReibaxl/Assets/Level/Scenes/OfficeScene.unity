  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &1873683527
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1873683507}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1308
  indentLevel: 0
  storyText: "No he podido hablar demasiado con \xE9l. La situaci\xF3n escapaba a
    mi control. No puedes culparme por eso."
  description: "Claro que no. Hablemos primero del ni\xF1o con el que has hablado.
    \xBFEst\xE1s satisfecho con c\xF3mo le has atendido?"
