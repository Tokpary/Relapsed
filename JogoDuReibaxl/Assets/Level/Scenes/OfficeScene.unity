  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1101
  indentLevel: 0
  storyText: "Me cost\xF3 mucho encontrar las palabras correctas, ten\xEDa mucho
    que decir y muy poco tiempo. Ojal\xE1 haber sacado el valor de actuar antes.  "
  description: 
  character: {fileID: 499699927}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
