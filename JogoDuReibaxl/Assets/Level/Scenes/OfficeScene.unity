  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1094
  indentLevel: 0
  storyText: "Si todav\xEDa quieres hablar con ella, yo creo que est\xE1s preparado
    para ello y conf\xEDo en que ser\xE1s capaz."
  description: 
  character: {fileID: 131937782}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
